# Copy to .env and adjust values for your environment.
# All values below are development placeholders; never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL ---
POSTGRES_DB=yavar
POSTGRES_USER=yavar
POSTGRES_PASSWORD=yavar
POSTGRES_HOST=localhost
# 5433 is the host port published by docker-compose (5432 inside Docker).
POSTGRES_PORT=5433

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (OpenAI-compatible). Empty key → rule-based reminders still work. ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- SMS: console logs OTP in backend output. Switch later to an Iranian gateway. ---
SMS_PROVIDER=console

# --- External providers: sandbox adapters are labeled آزمایشی in the UI. ---
PROVIDER_MODE=sandbox
PAYMENT_PROVIDER=sandbox
